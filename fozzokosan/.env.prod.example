# FőzzOkosan – éles környezet változói.
# Másold .env néven a docker-compose.prod.yml mellé, és töltsd ki!
#   cp .env.prod.example .env

# ---- PostgreSQL ----
POSTGRES_USER=fozzokosan
POSTGRES_PASSWORD=valtoztasd-meg-eros-jelszora
POSTGRES_DB=fozzokosan

# ---- JWT hitelesítés ----
# Erős, véletlenszerű titok, pl.:  openssl rand -base64 48
JWT_SECRET=valtoztasd-meg-hosszu-veletlen-titokra
JWT_EXPIRES_IN=7d

# ---- Google Gemini (NLP) – opcionális ----
# Üresen hagyva a szabályalapú tartalék parser fut.
GEMINI_API_KEY=

# ---- CORS ----
# Általában ÜRES: azonos originről (a domainről) szolgáljuk ki a frontendet és az API-t.
# Csak akkor töltsd ki (pl. https://app.pelda.hu), ha a frontend külön domainről jön.
CORS_ORIGIN=

# ---- HTTPS / domain ----
# A domain, ami a szerver IP-jére mutat (A-rekord). A Caddy erre kér Let's Encrypt
# tanúsítványt. Pl.:  DOMAIN=app.pelda.hu
DOMAIN=

# ---- Email (SMTP) – regisztráció megerősítése és jelszó-visszaállítás ----
# Az emailekben lévő linkek alapja (ahonnan a felhasználó eléri az appot).
# Pl. https://app.pelda.hu  vagy egyelőre  http://A-VPS-IP
APP_URL=
MAIL_FROM=FőzzOkosan <az-igazolt-felado@email>

# AJÁNLOTT: email-küldés HTTP API-n (443-as port), ha a VPS blokkolja az SMTP-t.
# Elég az EGYIKET beállítani.
#  - SendGrid: Single Sender hitelesítés kell (domain nélkül is megy); 100 email/nap.
#  - Resend: saját domain igazolása kell tetszőleges címzetthez.
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMTP (csak ha a szolgáltató engedi a kimenő SMTP-t; különben hagyd üresen).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
