# Helyi fejlesztői környezet változói (docker-compose.yml).
# Másold .env néven, és töltsd ki:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=fozzokosan
POSTGRES_PASSWORD=valtoztasd-meg
POSTGRES_DB=fozzokosan

# JWT
JWT_SECRET=valtoztasd-meg-egy-veletlen-titokra
JWT_EXPIRES_IN=7d

# Google Gemini (NLP) – opcionális
GEMINI_API_KEY=

# Megjegyzés: éles (VPS) telepítéshez lásd a .env.prod.example fájlt
# (az tartalmazza a DOMAIN változót is a HTTPS-hez).
