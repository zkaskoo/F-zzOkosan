# A DOMAIN környezeti változóból jön (.env). A Caddy automatikusan kér és
# megújít Let's Encrypt tanúsítványt, és a HTTP-t HTTPS-re irányítja.
{$DOMAIN} {
	encode gzip
	reverse_proxy nginx:80
}

# www átirányítása a fő domainre (mindkettőre kér tanúsítványt a Caddy).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
