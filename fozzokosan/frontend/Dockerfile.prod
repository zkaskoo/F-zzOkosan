# ---- Build stage ----
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
# Production build. VITE_API_URL szándékosan nincs beállítva: a frontend
# relatív /api-t hív, amit az nginx proxyz a backendre (azonos origin, nincs CORS).
RUN npm run build

# ---- Runtime stage (nginx) ----
FROM nginx:alpine
# A legenerált statikus frontend
COPY --from=builder /app/dist /usr/share/nginx/html
# Reverse proxy + SPA konfiguráció
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
