# Database
DATABASE_URL="postgresql://fozzokosan:fozzokosan123@localhost:5432/fozzokosan?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# CORS — a production frontend domain(ek), vesszővel elválasztva.
# Pl.: CORS_ORIGIN="https://fozzokosan.vercel.app"
# Helyi fejlesztéshez üresen hagyható (a localhost mindig engedélyezett).
CORS_ORIGIN=""

# Google Gemini API (for NLP)
GEMINI_API_KEY="your-gemini-api-key"

# Email (SMTP) — regisztráció megerősítése, jelszó-visszaállítás.
# Üres SMTP_HOST esetén az emailek nem mennek ki, a linkek a logba kerülnek.
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FőzzOkosan <no-reply@fozzokosan.local>"
